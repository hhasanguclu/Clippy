<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Clippy.Forms.SettingsWindow"
        Title="Clippy Settings"
        Width="420" Height="300"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#1E1E1E">

  <StackPanel Margin="24">
    <!-- Language -->
    <TextBlock Text="Language" Foreground="#DCDCDC" FontSize="13" Margin="0,0,0,6"/>
    <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" Margin="0,0,0,16">
      <ComboBoxItem Content="English"/>
      <ComboBoxItem Content="Türkçe"/>
    </ComboBox>

    <!-- Max History -->
    <TextBlock Text="Max History Items" Foreground="#DCDCDC" FontSize="13" Margin="0,0,0,6"/>
    <NumericUpDown x:Name="MaxHistoryNumeric"
                   Minimum="10" Maximum="10000"
                   HorizontalAlignment="Stretch"
                   Margin="0,0,0,16"/>

    <!-- Start with OS -->
    <CheckBox x:Name="StartupCheckBox"
              Content="Start with system"
              Foreground="#DCDCDC"
              Margin="0,0,0,24"/>

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="SaveButton" Content="Save" Width="90"
              Background="#007ACC" Foreground="White"/>
      <Button x:Name="CancelButton" Content="Cancel" Width="90"/>
    </StackPanel>
  </StackPanel>
</Window>
