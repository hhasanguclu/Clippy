  <data name="Msg_CaptureResumed" xml:space="preserve"><value>Clipboard capture resumed</value></data>
  <data name="Msg_CapturePaused" xml:space="preserve"><value>Clipboard capture paused</value></data>
  <data name="Msg_IgnoreNextActive" xml:space="preserve"><value>Next clipboard copy will be ignored</value></data>
  <data name="Msg_HotkeyFailed" xml:space="preserve"><value>Failed to register hotkey. Another application may be using it.</value></data>

