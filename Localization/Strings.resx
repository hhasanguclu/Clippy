  <data name="Settings_MaxHistory" xml:space="preserve"><value>Max History Items</value></data>
  <data name="Settings_Hotkey" xml:space="preserve"><value>Hotkey</value></data>
  <data name="Settings_StartWithWindows" xml:space="preserve"><value>Start with system</value></data>
  <data name="Settings_Save" xml:space="preserve"><value>Save</value></data>
  <data name="Settings_Cancel" xml:space="preserve"><value>Cancel</value></data>
