  <data name="TrayMenu_PauseCapture" xml:space="preserve"><value>Pause Capture</value></data>
  <data name="TrayMenu_ResumeCapture" xml:space="preserve"><value>Resume Capture</value></data>
  <data name="TrayMenu_ClearHistory" xml:space="preserve"><value>Clear History</value></data>
  <data name="TrayMenu_Settings" xml:space="preserve"><value>Settings</value></data>
  <data name="TrayMenu_Exit" xml:space="preserve"><value>Exit</value></data>
  <data name="TrayMenu_IgnoreNext" xml:space="preserve"><value>Ignore Next Copy</value></data>

  <!-- Popup -->
  <data name="Popup_Title" xml:space="preserve"><value>Clippy — Clipboard History</value></data>
  <data name="Popup_SearchPlaceholder" xml:space="preserve"><value>Search clipboard history...</value></data>
  <data name="Popup_NoResults" xml:space="preserve"><value>No results found</value></data>
  <data name="Popup_Pinned" xml:space="preserve"><value>📌 Pinned</value></data>
